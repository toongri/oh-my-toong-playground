      "topics": [
        {
          "id": "m1-t1",
          "title": "넓은 공간으로 전개하기",
          "summary": "브라이드 쪽에서 TIMEJ에게 연결되는 장면을 바탕으로, 좁은 곳에 있는 선수보다 넓은 공간의 선수를 보는 패스 선택을 짚습니다.",
          "unit_ids": [
            "u001"
          ]
        },
        {
          "id": "m1-t2",
          "title": "수신 중 조작과 방향 유지",
          "summary": "택시가 공을 잡는 상황을 예로 들어 LT를 누른 채 움직이는 조작을 설명합니다.",
          "unit_ids": [
            "u002"
          ]
        },
        {
          "id": "m1-t3",
          "title": "역습 지원과 위치 조정",
          "summary": "조민에게 아쉬운 점을 짚으며, 사인드가 낮게 내려온 장면에서 루미의 측면 역할과 공을 가진 팀원에게 선택지를 만드는 지원 위치를 설명합니다.",
          "unit_ids": [
            "u003"
          ]
        },
        {
          "id": "m1-t4",
          "title": "압박에서 공을 살리는 선택",
          "summary": "압박 전에 뒤로 내주고 다시 연결하는 방법과, TIMEJ에게 곧장 연결하기보다 공을 더 운반해 상대를 끌어내고 동료가 올라올 시간을 만드는 방법을 다룹니다.",
          "unit_ids": [
            "u004",
            "u005",
            "u006"
          ]
        },
        {
          "id": "m1-t5",
          "title": "넓은 공간을 활용하는 공격",
          "summary": "팀의 간격을 넓히고, 제라드에게 연결해 존재가 넓은 공간에서 선택할 수 있도록 하는 전개를 다룹니다.",
          "unit_ids": [
