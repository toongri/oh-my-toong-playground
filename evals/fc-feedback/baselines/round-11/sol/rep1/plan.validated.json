  "session_title": "FC Barcelona 팀 연습 피드백 — 공간 활용과 안전한 전개",
  "matches": [
    {
      "id": "m1",
      "title": "BRO 대 FCB 연습 경기",
      "topics": [
        {
          "id": "m1-t1",
          "title": "넓은 공간으로 전개하기",
          "summary": "좁은 곳의 동료에게 바로 주기보다 넓은 곳을 택해 공을 운반하고, 공 없는 선수에게 전진할 시간을 준다.",
          "unit_ids": [
            "u001",
            "u002"
          ]
        },
        {
          "id": "m1-t2",
          "title": "역습과 패스 선택지",
          "summary": "사인드가 낮은 역습에서는 루미가 측면 역할을 채워 기프에게 두 패스 선택지를 만든다. 압박이 가까우면 안전하게 뒤로 내주고 다시 받을 길을 찾는다.",
          "unit_ids": [
            "u003",
            "u004",
            "u005"
          ]
        },
        {
          "id": "m1-t3",
          "title": "측면 공간과 역할 교대",
          "summary": "막힌 전개에서 넓은 측면을 찾고, 원전이 올라가면 사인드가 중앙으로 들어가는 역할 교대를 점검한다.",
          "unit_ids": [
            "u006",
            "u007"
          ]
        },
        {
          "id": "m1-t4",
          "title": "대각 패스와 수비 판단",
          "summary": "측면에서 중원으로 대각으로 빼 중원이 전방 선수를 볼 시간을 만든다. 원전의 태클과 페널티 장면을 돌아보고, 촘촘한 수비 앞에서는 공을 뒤로 돌린다.",
          "unit_ids": [
            "u008",
            "u009",
            "u010"
          ]
        },
        {
          "id": "m1-t5",
          "title": "패스 높이와 막힌 돌파",
          "summary": "열린 패스 길은 땅볼로 연결하고, 돌파 길이 막히면 뒤의 지원 선수에게 공을 살려 다른 전개를 택한다.",
          "unit_ids": [
            "u011",
            "u012"
          ]
        }
      ]
    }
