      "id": "m1",
      "title": "BRO vs FC Barcelona",
      "topics": [
        {
          "id": "m1-t1",
          "title": "넓은 공간과 공 받는 방향",
          "summary": "좁은 곳에 공을 몰아넣기보다 넓은 쪽으로 연결하고, 공을 받은 선수는 LT로 방향을 유지하며 다음 동작을 이어갑니다.",
          "unit_ids": [
            "u001",
            "u002"
          ]
        },
        {
          "id": "m1-t2",
          "title": "역습에서 역할과 움직임 만들기",
          "summary": "사인드가 낮은 역습 장면에서 루미가 윙어 역할로 폭을 맡아야 합니다. 그 움직임으로 기프가 TIMEJ나 유미 중 한 명을 고를 수 있고, 사인드와 맥구도 같은 지원을 해야 합니다.",
          "unit_ids": [
            "u003"
          ]
        },
        {
          "id": "m1-t3",
          "title": "압박을 받기 전 빌드업 선택",
          "summary": "압박을 받으면 뒤로 내주고 LT로 다시 받는 선택을 설명하며, 전진이 어려울 때 샘백에게 연결해 수비를 끌어내는 별도 방법도 제시합니다.",
          "unit_ids": [
            "u004"
          ]
        },
        {
          "id": "m1-t4",
          "title": "루미의 침투 타이밍",
          "summary": "TIMEJ는 이 장면에서 루미가 올라올 것으로 기대했지만 움직임이 멈춘 점을 짚습니다.",
          "unit_ids": [
            "u005"
          ]
        },
        {
          "id": "m1-t5",
          "title": "운반으로 압박을 끌고 세로 폭 만들기",
          "summary": "공을 바로 돌려주기보다 더 운반해 상대를 끌고, 동료가 올라올 시간을 벌어야 합니다. 성공하면 TIMEJ가 더 높은 진영에서 탈압박할 수 있지만, 우리 진영에서 공을 잃으면 즉시 역습 위험이 있습니다.",
          "unit_ids": [
            "u006"
          ]
        },
        {
          "id": "m1-t6",
          "title": "세로 폭을 활용한 전개",
          "summary": "세로 방향으로 넓게 벌려 전개할 필요를 짚습니다.",
          "unit_ids": [
            "u007"
          ]
        },
        {
          "id": "m1-t7",
          "title": "막힌 전개에서 넓은 공간 찾기",
          "summary": "전개가 막힌 순간 제라드에게 연결하면 존재가 넓은 공간을 활용해 운반하거나 크로스·컷백을 선택할 수 있습니다.",
          "unit_ids": [
            "u008"
          ]
        },
        {
          "id": "m1-t8",
          "title": "공격 시 위치와 타이밍",
          "summary": "원전이 전진할 때 TIMEJ는 뒤를 받치고 사인드는 중앙으로 들어가는 선택을 원했으며, 아쉽다는 평가 뒤 장면이 골로 끝납니다.",
          "unit_ids": [
            "u009"
          ]
        },
        {
          "id": "m1-t9",
          "title": "대각 패스로 공격 전개",
          "summary": "측면에서 대각선으로 빼 주면 중원이 넓은 공간으로 뛰는 선수를 볼 여유가 생깁니다.",
          "unit_ids": [
            "u010"
          ]
        },
        {
          "id": "m1-t10",
          "title": "수비 균형과 페널티 관리",
          "summary": "원전이 균형을 잃은 뒤 공을 빼앗으려 태클을 눌렀고, 그 과정에서 페널티를 내줍니다.",
          "unit_ids": [
            "u011"
          ]
        },
        {
          "id": "m1-t11",
          "title": "밀집 수비에서는 뒤로 빼기",
          "summary": "상대 수비가 촘촘히 모이면 공격을 밀어붙이지 말고 뒤쪽 지원을 이용해 공을 다시 빼야 합니다.",
          "unit_ids": [
            "u012"
          ]
        },
        {
          "id": "m1-t12",
          "title": "하프 패스의 높이 조절",
          "summary": "하프에서 연결할 때 땅으로 줄 수 있으면 낮게 보내고, 열린 공간에는 띄운 패스도 고려합니다.",
          "unit_ids": [
            "u013"
          ]
        },
        {
          "id": "m1-t13",
          "title": "막혔을 때 볼을 안전하게 살리기",
          "summary": "맥구가 막힌 공간에서 돌파만 이어가기보다 뒤로 받쳐주는 선수에게 주고 오버래핑을 올리는 등 선택을 다양하게 가져갈 필요가 있습니다.",
          "unit_ids": [
            "u014"
          ]
        },
        {
          "id": "m1-t14",
          "title": "경기 후 공통 정리",
          "summary": "마지막에는 봐야 할 뒤 대각을 놓친 점과 상대 수비가 밀집했을 때 뒤로 빼야 한다는 점을 팀 전체에 다시 당부합니다.",
          "unit_ids": [
            "u015"
          ]
        }
      ]
    }
  ],
