      "title": "BRO 대 FCB 연습경기",
      "topics": [
        {
          "id": "m1-t1",
          "title": "넓은 공간으로 전개",
          "summary": "좁은 곳의 동료보다 넓은 곳의 동료를 보고 공을 옮기는 선택을 짚는다.",
          "unit_ids": [
            "u001"
          ]
        },
        {
          "id": "m1-t2",
          "title": "공을 받는 자세와 LT 조작",
          "summary": "공을 받기 전 몸의 방향을 유지하며 움직이는 LT 조작을 설명한다.",
          "unit_ids": [
            "u002"
          ]
        },
        {
          "id": "m1-t3",
          "title": "역습 때 패스 선택지 만들기",
          "summary": "사인드가 낮게 있는 역습에서 루미의 윙어 역할과 공을 가진 선수에게 열어 줄 패스 경로를 설명한다.",
          "unit_ids": [
            "u003"
          ]
        },
        {
          "id": "m1-t4",
          "title": "압박 속 전진 선택",
          "summary": "압박이 오는 공을 곧장 전진시키는 판단과 뒤로 내준 뒤 다시 받는 선택을 비교한다.",
          "unit_ids": [
            "u004",
            "u005"
          ]
        },
        {
          "id": "m1-t5",
          "title": "전진 드리블과 패스 시점",
          "summary": "루미가 멈춘 장면을 아쉬워한다. 이후 너무 이른 패스보다 공을 더 몰아 상대를 끌어낸 뒤 패스하자는 설명이 이어진다.",
          "unit_ids": [
            "u006",
            "u007"
          ]
        },
        {
          "id": "m1-t6",
          "title": "막힌 공격에서 방향 전환",
          "summary": "한쪽이 막혔을 때 존재가 넓은 공간을 쓰는 선택을 짚는다.",
          "unit_ids": [
            "u008"
          ]
        },
        {
          "id": "m1-t7",
          "title": "측면 오버래핑과 중앙 침투",
          "summary": "원전이 올라오는 동안 사인드의 위치를 조정하고 TIMEJ가 뒤를 메우는 선택을 설명한다. 장면 끝의 득점 반응도 남긴다.",
          "unit_ids": [
            "u009"
          ]
        },
        {
          "id": "m1-t8",
          "title": "중원에서 대각 패스",
          "summary": "스프레스의 패스 선택을 계기로 중원이 넓은 공간의 전방 주자를 볼 수 있도록 대각으로 빼주는 움직임을 강조한다.",
          "unit_ids": [
            "u010"
          ]
        },
        {
          "id": "m1-t9",
          "title": "수비 판단과 압박 대응",
          "summary": "원전의 밸런스와 태클 판단, 촘촘한 수비를 상대한 공격의 후방 패스를 짚는다.",
          "unit_ids": [
            "u011",
            "u012"
          ]
        },
        {
          "id": "m1-t10",
          "title": "패스 방식과 돌파 중단",
          "summary": "가능하면 땅볼로 주고, 맥구가 돌파 공간을 잃었을 때 뒤를 보는 선택을 정리한다.",
          "unit_ids": [
            "u013",
            "u014"
          ]
        }
