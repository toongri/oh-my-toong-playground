  "units": [
    {
      "id": "u001",
      "uid": "20240104-NUzEChn9EyI#u001",
      "match_id": "m1",
      "topic_id": "m1-t1",
      "video": "NUzEChn9EyI",
      "start": 75.12,
      "end": 103.42,
      "title": "좁은 곳 대신 넓은 곳으로 패스",
      "position_tags": [],
      "topic_tags": [
        "빌드업"
      ],
      "member_ids": [],
      "related_member_ids": [],
      "addressed_to_all": true,
      "body": [
        {
          "type": "text",
          "text": "공을 좁은 공간의 동료에게 보내려는 장면에서는 누구든 공을 가진 선수라면 **넓은 공간의 동료에게 패스하는 선택**을 먼저 봐야 한다. 그쪽이 공을 운반하기 쉽고, 운반하는 동안 공이 없는 동료가 올라갈 시간도 생긴다는 설명이다."
        },
        {
          "type": "text",
          "text": "좁은 쪽으로 왔다가 다시 뒤로 빼는 선택도 짚었다."
        },
        {
          "type": "frame",
          "src": "img/u001-c004.webp",
          "width": 854,
          "height": 460,
          "t": 90,
          "caption": "중원 주변의 흰색·남색 선수들과 코치 TIMEJ가 그린 파란 구역선, 붉은 화살표가 보인다."
        }
      ],
