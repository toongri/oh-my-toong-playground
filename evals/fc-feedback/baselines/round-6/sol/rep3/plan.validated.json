{
  "version": 1,
  "session_title": "FC Barcelona 팀 연습 Part 3 — 공간 선택과 안전한 전개",
  "matches": [
    {
      "id": "m1",
      "title": "BRO 대 FCB 경기 피드백",
      "topics": [
        {
          "id": "m1-t1",
          "title": "초반 전개와 패스 선택",
          "summary": "넓은 공간을 찾는 패스와 LT 조작, TIMEJ 자신의 패스 선택을 돌아본다. TIMEJ는 뒤쪽을 보고 스루패스를 줬고, 템포를 올리려 W패스를 택한 자신의 플레이도 돌아본다.",
          "unit_ids": [
            "u001",
            "u002"
          ]
        },
        {
          "id": "m1-t2",
          "title": "역습에서 선택지 만들기",
          "summary": "루미가 측면에서 뛰어 기프의 두 패스 선택지를 열어야 한다.",
          "unit_ids": [
            "u003"
          ]
        },
        {
          "id": "m1-t3",
          "title": "압박을 벗어나 안전하게 전개하기",
          "summary": "공을 받을 때 압박을 미리 보고 뒤로 내주며, 샘백을 활용한다.",
          "unit_ids": [
            "u004"
          ]
        },
        {
          "id": "m1-t4",
          "title": "루미의 움직임과 좁은 공간으로의 패스",
          "summary": "루미가 멈춘 장면과 좁은 공간의 TIMEJ에게 일찍 주는 경향을 짚는다. 더 몰고 와 상대를 끌어낸다는 지시가 이어진다.",
          "unit_ids": [
            "u005",
            "u006"
          ]
        },
        {
          "id": "m1-t5",
          "title": "막힌 중앙에서 넓은 공간 활용",
          "summary": "중앙이 막히면 넓은 공간을 활용하고, 사인드와 원전의 동선을 조정한다.",
          "unit_ids": [
            "u007",
            "u008"
          ]
        },
        {
          "id": "m1-t6",
          "title": "대각 전개와 수비 균형",
          "summary": "중원에서 대각으로 빼주는 선택과 원전의 페널티 장면을 짚는다. 원전이 균형을 무너뜨리고 공을 빼앗으려다 페널티로 이어진 평가도 남긴다.",
          "unit_ids": [
            "u009"
          ]
        },
        {
          "id": "m1-t7",
          "title": "밀집 수비와 패스의 높이",
          "summary": "촘촘한 수비 앞에서는 뒤로 빼고, 열린 패스 길에는 땅볼로 연결한다.",
          "unit_ids": [
            "u010",
            "u011"
          ]
        },
        {
          "id": "m1-t8",
          "title": "맥구의 돌파 선택",
          "summary": "단독 돌파가 막히면 뒤쪽 지원을 보고 공을 살리라고 한다. 마지막 총평에서 대각 패스와 뒤로 빼는 선택을 다시 강조한다.",
          "unit_ids": [
            "u012"
          ]
        }
      ]
    }
  ],
