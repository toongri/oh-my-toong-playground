      "end": 103.42,
      "title": "좁은 곳보다 넓은 곳의 선수에게 연결",
      "position_tags": [
        "MF"
      ],
      "topic_tags": [
        "빌드업"
      ],
      "member_ids": [],
      "related_member_ids": [
        "gerrard",
