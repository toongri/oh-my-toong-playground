      "topics": [
        {
          "id": "m1-t1",
          "title": "공간 선택과 공 받는 자세",
          "summary": "좁은 곳보다 넓은 곳의 동료에게 연결하고, 공을 받을 때 LT로 몸의 방향을 유지한다.",
          "unit_ids": [
            "u001",
            "u002",
            "u003"
          ]
        },
        {
          "id": "m1-t2",
          "title": "역습 때 패스 선택지 만들기",
          "summary": "측면 역할과 침투 동선을 분담해 공을 가진 동료에게 선택지를 제공한다.",
          "unit_ids": [
            "u004"
          ]
        },
        {
          "id": "m1-t3",
          "title": "압박을 피하는 후방 전개",
          "summary": "압박이 들어오는 장면에서는 뒤로 연결하고, 전방 패스의 난도를 낮출 선택지를 찾는다.",
          "unit_ids": [
            "u005",
            "u006",
            "u007",
            "u008",
            "u009"
          ]
        },
        {
          "id": "m1-t4",
          "title": "공간 활용과 측면 진입",
          "summary": "중앙이 막힌 장면에서는 넓은 공간을 찾아 전개하고, 원전의 측면 전진에 맞춰 사인드의 위치를 조정한다.",
          "unit_ids": [
            "u010",
            "u011"
          ]
        },
        {
          "id": "m1-t5",
          "title": "대각 연결과 수비 판단",
          "summary": "앞으로 뛰는 동료를 볼 수 있도록 대각 연결을 찾는다. 수비 때 무리한 태클을, 공격 때 밀집 수비 앞에서의 선택을 돌아본다.",
          "unit_ids": [
            "u012",
            "u013",
            "u014"
          ]
        },
        {
          "id": "m1-t6",
          "title": "패스 높이와 막힌 돌파의 대안",
          "summary": "받는 동료가 속도를 살릴 수 있게 패스 높이를 선택하고, 막힌 돌파 대신 후방 옵션을 활용한다.",
          "unit_ids": [
            "u015",
            "u016"
          ]
        }
      ]
    }
