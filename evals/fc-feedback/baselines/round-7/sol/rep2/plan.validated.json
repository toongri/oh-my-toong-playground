{
  "version": 1,
  "session_title": "FC Barcelona 팀 연습 Part 3 — 공간 활용과 패스 선택 피드백",
  "matches": [
    {
      "id": "m1",
      "title": "BRO 대 FCB 연습 경기",
      "topics": [
        {
          "id": "m1-t1",
          "title": "좁은 곳보다 넓은 공간으로 연결",
          "summary": "브라이드에게서 TIMEJ 쪽으로 공이 오는 장면을 짚으며, 좁은 공간보다 넓은 공간의 선수에게 연결해 운반과 동료의 전진 시간을 확보하자고 한다.",
          "unit_ids": [
            "u001"
          ]
        },
        {
          "id": "m1-t2",
          "title": "LT로 공 가진 선수를 바라보며 움직이기",
          "summary": "공을 가진 동료 주변에서 LT를 누른 채 움직이면 몸이 돌아가지 않고 공을 가진 사람을 바라볼 수 있다고 설명한다.",
          "unit_ids": [
            "u002"
          ]
        },
        {
          "id": "m1-t3",
          "title": "역습 때 루미의 측면 움직임으로 두 선택지 열기",
          "summary": "조민에게 아쉬움을 언급하며 시작하지만, 핵심 교정은 낮은 사인드를 대신해 루미가 측면을 뛰어 기프에게 두 패스 선택지를 주는 것이다.",
          "unit_ids": [
            "u003"
          ]
        },
        {
          "id": "m1-t4",
          "title": "압박 전에 뒤로 내주고 다시 받기",
          "summary": "압박이 들어올 수 있는 순간의 불필요한 동작을 짚고, 뒤로 내준 뒤 LT를 눌러 돌려받는 방법을 말한다. Gerrard_CEF의 전방 연결보다 샘백을 거쳐 수비를 끌어내는 선택도 제시한다.",
          "unit_ids": [
            "u004"
          ]
        },
        {
          "id": "m1-t5",
          "title": "성급한 패스 대신 운반해 선택지 만들기",
          "summary": "성급한 패스보다 공을 더 몰고 가 수비를 끌어낸 뒤 동료가 올라올 시간을 주라고 한다. 우리 진영에서 공을 잃으면 역습을 맞는 위험도 짚는다.",
          "unit_ids": [
            "u005"
          ]
        },
        {
          "id": "m1-t6",
          "title": "상하로 넓게 벌리는 팀 전개",
          "summary": "팀 전체가 상하로 넓게 벌려 플레이할 필요가 있다는 총평이다.",
          "unit_ids": [
            "u006"
          ]
        },
        {
          "id": "m1-t7",
          "title": "막힌 공격에서 반대쪽 넓은 공간 활용",
          "summary": "공격이 완전히 막히면 Gerrard_CEF를 거쳐 존재가 넓은 공간을 활용하고 크로스 또는 컷백을 할 선택지를 말한다.",
          "unit_ids": [
            "u007"
          ]
        },
        {
          "id": "m1-t8",
          "title": "원전이 측면을 오르면 사인드는 중앙으로",
          "summary": "원전이 측면을 몰고 올라갈 때 사인드는 중앙으로 들어가고, 뒤에 있는 TIMEJ가 빈 중앙 공간을 메우는 배치를 말한다.",
          "unit_ids": [
            "u008"
          ]
        },
        {
          "id": "m1-t9",
          "title": "중원으로 대각 패스를 빼 넓은 공간 보기",
          "summary": "스프레스의 장면에서 공을 중원으로 대각으로 빼주면 중원이 넓은 공간에서 앞으로 뛰는 선수를 볼 여유가 생긴다고 한다.",
          "unit_ids": [
            "u009"
          ]
        },
        {
          "id": "m1-t10",
          "title": "원전의 무리한 태클과 페널티킥",
          "summary": "원전이 균형을 잃은 상황에서 공을 뺏으려 태클을 시도했고 페널티킥으로 이어졌다고 지적한다.",
          "unit_ids": [
            "u010"
          ]
        },
        {
          "id": "m1-t11",
          "title": "촘촘한 수비 앞에서 뒤로 빼기",
          "summary": "상대 수비가 촘촘하면 공격을 밀어붙이지 말고 뒤로 빼야 한다고 한다.",
          "unit_ids": [
            "u011"
          ]
        },
        {
          "id": "m1-t12",
          "title": "열린 길은 땅볼로, 막힐 때만 띄워서",
          "summary": "받는 사람이 공의 속도를 살리도록 땅볼로 줄 수 있으면 땅볼을 우선하고, 사이가 막힐 듯할 때 띄우는 선택을 말한다.",
          "unit_ids": [
            "u012"
          ]
        },
        {
          "id": "m1-t13",
          "title": "맥구는 막힌 돌파보다 뒤의 지원 활용",
          "summary": "맥구가 막힌 길로 계속 돌파하기보다 뒤의 지원을 보고 안전하게 살리거나 다른 전개를 선택하자고 한다.",
          "unit_ids": [
            "u013"
          ]
        },
        {
          "id": "m1-t14",
          "title": "경기 마지막 총평",
          "summary": "대각 방향을 볼 타이밍을 놓친 점과 밀집 수비 앞에서 뒤로 빼는 판단을 팀 전체 과제로 짚는다.",
          "unit_ids": [
            "u014"
          ]
        }
      ]
    }
  ],
