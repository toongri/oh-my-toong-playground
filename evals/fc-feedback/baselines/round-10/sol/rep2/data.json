          "unit_ids": [
            "u002"
          ]
        },
        {
          "id": "m1-t3",
          "title": "역습 전개와 패스 선택",
          "summary": "빠르게 전진하려던 스루패스 선택과, 측면 역할을 메워 패스 선택지를 만드는 움직임을 돌아본다.",
          "unit_ids": [
            "u003",
