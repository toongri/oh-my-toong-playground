      "title": "Bros Vamos vs CEF Barcelona",
      "topics": [
        {
          "id": "m1-t1",
          "title": "넓은 공간으로 전개하기",
          "summary": "좁은 곳에 바로 넣기보다 열린 넓은 쪽으로 패스해 공을 옮기고, 공이 없는 선수들이 올라올 시간을 만든다.",
          "unit_ids": [
            "u001"
          ]
        },
        {
          "id": "m1-t2",
          "title": "압박을 받는 상황의 조작과 전개",
          "summary": "상대를 등지거나 급히 전진하기보다 몸 방향과 다음 패스 선택을 정리한다.",
          "unit_ids": [
            "u002"
          ]
        },
        {
          "id": "m1-t3",
          "title": "역습 때 높낮이와 지원 선택지 만들기",
          "summary": "한 선수가 내려오면 다른 선수가 측면 폭과 전방 높이를 채워 가까운 패스와 넓은 패스를 모두 연다.",
          "unit_ids": [
            "u003"
          ]
        },
        {
          "id": "m1-t4",
          "title": "압박 아래서 안전하게 다시 연결하기",
          "summary": "압박이 들어오기 전에 공을 내주고 다시 받는 동작을 써서 위험한 전진 패스를 줄인다.",
          "unit_ids": [
            "u004"
          ]
        },
        {
          "id": "m1-t5",
          "title": "공이 없을 때 전방 움직임",
          "summary": "공을 받을 수 있는 전방 공간이 열리면 멈추지 말고 침투 움직임을 이어간다.",
          "unit_ids": [
            "u005"
          ]
        },
        {
          "id": "m1-t6",
          "title": "공을 운반해 상대 수비를 끌어내기",
          "summary": "급히 좁은 곳으로 넣기보다 공을 몰고 상대 한 명을 끌어내 동료가 올라올 시간을 확보한다.",
          "unit_ids": [
            "u006"
          ]
        },
        {
          "id": "m1-t7",
          "title": "공격 폭과 전진 선택지",
          "summary": "세로와 가로로 폭을 벌려 상대 수비를 늘리고 넓은 쪽에서 전진할 길을 만든다.",
          "unit_ids": [
            "u007"
          ]
        },
        {
          "id": "m1-t8",
          "title": "넓은 공간의 침투를 살리기",
          "summary": "전방으로 달려드는 선수가 넓은 쪽을 활용할 수 있도록 패스 타이밍과 크로스·컷백 선택을 맞춘다.",
          "unit_ids": [
            "u008"
          ]
        },
        {
          "id": "m1-t9",
          "title": "역습에서 측면과 중앙 역할 나누기",
          "summary": "사인드가 낮은 위치에 있으면 루미가 윙어 역할을 맡고, 기프·유미에게 이어지는 두 패스 옵션을 유지한다.",
          "unit_ids": [
            "u009"
          ]
        },
        {
          "id": "m1-t10",
          "title": "넓은 공간으로 대각 전개하기",
          "summary": "중원이 전방 침투를 볼 시간을 만들 수 있도록 안쪽만 고집하지 말고 대각으로 공을 뺀다.",
          "unit_ids": [
