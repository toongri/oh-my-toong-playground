      "id": "m1",
      "title": "BRO vs FCB (1–2)",
      "topics": [
        {
          "id": "m1-t1",
          "title": "넓은 공간을 살리는 전개",
          "summary": "좁은 공간의 선수보다 넓은 공간의 선수를 찾아 연결하고, 공을 운반하는 동안 동료가 올라갈 시간을 확보하는 장면입니다.",
          "unit_ids": [
            "u001"
          ]
        },
        {
          "id": "m1-t2",
          "title": "공을 받은 뒤 방향을 유지하고 전진하기",
          "summary": "LT를 누른 움직임으로 방향을 유지하는 방법과 이후 전진 움직임·패스 장면을 돌아봅니다.",
          "unit_ids": [
            "u002",
            "u003"
          ]
        },
        {
          "id": "m1-t3",
          "title": "역습에서 공격 선택지 만들기",
          "summary": "낮게 내려온 측면 역할을 보완하고, 역습에서 여러 패스 선택지가 열리도록 움직임을 나눕니다.",
          "unit_ids": [
            "u004"
          ]
        },
        {
          "id": "m1-t4",
          "title": "압박 아래 연결과 안전한 전개",
          "summary": "압박이 올 때 불필요한 동작과 무리한 전진 패스를 줄이고, 동료를 활용해 전개를 이어가는 장면입니다.",
          "unit_ids": [
            "u005"
          ]
        },
        {
          "id": "m1-t5",
          "title": "전방 움직임과 팀 폭",
          "summary": "루미의 움직임을 이어가고, 공을 더 몰아 상대를 끌어내며, 팀 폭을 넓히라는 피드백을 정리합니다.",
          "unit_ids": [
            "u006",
            "u007",
            "u008"
          ]
        },
        {
          "id": "m1-t6",
          "title": "넓은 공간과 중앙 침투 활용하기",
          "summary": "제라드에게 연결해 존재가 넓은 공간을 활용하고, 크로스나 컷백으로 마무리하는 선택지를 다룹니다.",
          "unit_ids": [
            "u009"
          ]
        },
        {
          "id": "m1-t7",
          "title": "측면 전진과 중앙 공간 채우기",
          "summary": "원전이 측면으로 올라갈 때 사인드가 중앙으로 움직이고, TIMEJ는 뒤에서 중앙 공간을 메우는 배치를 설명합니다.",
          "unit_ids": [
            "u010"
          ]
        },
        {
          "id": "m1-t8",
          "title": "대각 전개와 수비 밸런스",
          "summary": "중원에서 전방으로 뛸 선수를 볼 수 있도록 대각으로 연결하는 장면과, 태클 시도 뒤 페널티 상황이 된 장면을 따로 다룹니다.",
          "unit_ids": [
            "u011",
            "u012"
          ]
        },
        {
          "id": "m1-t9",
          "title": "밀집 수비 대응과 패스 선택",
          "summary": "상대 수비가 촘촘할 때는 뒤로 빼고, 상황에 맞춰 지상 패스와 높은 패스를 선택하며, 막혔을 때는 안전하게 소유권을 지킵니다.",
          "unit_ids": [
            "u013",
            "u014",
            "u015"
          ]
        },
        {
          "id": "m1-t10",
          "title": "오늘 경기의 팀 공통 포인트",
          "summary": "뒤 대각 선택을 보고, 상대 수비가 밀집되어 있으면 미련 없이 뒤로 빼라는 마무리 지시입니다.",
          "unit_ids": [
            "u016"
          ]
        }
      ]
    }
