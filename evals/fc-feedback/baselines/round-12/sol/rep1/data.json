      "title": "공 주변에서 LT로 상대를 바라보며 움직이기",
      "position_tags": [
        "MF"
      ],
      "topic_tags": [
        "조작/키사용"
      ],
      "member_ids": [
        "taxi"
      ],
      "related_member_ids": [
        "gerrard",
