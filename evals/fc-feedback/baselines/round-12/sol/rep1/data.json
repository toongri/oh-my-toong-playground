      "start": 463.08000000000004,
      "end": 526.78,
      "title": "압박이 오면 뒤로 내주고 다시 받기",
      "position_tags": [
        "MF"
      ],
      "topic_tags": [
        "탈압박",
        "빌드업"
      ],
      "member_ids": [
