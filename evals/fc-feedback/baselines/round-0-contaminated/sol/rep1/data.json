    {
      "id": "u002",
      "uid": "20240104-NUzEChn9EyI#u002",
      "match_id": "m1",
      "topic_id": "m1-t1",
      "video": "NUzEChn9EyI",
      "start": 225.9,
      "end": 255.12,
      "title": "LT로 패스 받을 자세 유지",
      "position_tags": [
        "MF"
      ],
      "topic_tags": [
        "조작/키사용"
      ],
      "member_ids": [],
      "related_member_ids": [
