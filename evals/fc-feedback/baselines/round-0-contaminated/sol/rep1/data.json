      "title": "좁은 쪽 대신 넓은 쪽으로 전개",
      "position_tags": [
        "MF"
      ],
      "topic_tags": [
        "빌드업"
      ],
      "member_ids": [],
      "related_member_ids": [
        "gerrard",
