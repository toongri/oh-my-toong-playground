      "start": 489.72,
      "end": 526.78,
      "title": "전진 패스보다 측면을 거쳐 수비 이동시키기",
      "position_tags": [
        "MF"
      ],
      "topic_tags": [
        "빌드업",
        "탈압박"
      ],
      "member_ids": [
