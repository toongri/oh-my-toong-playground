      "title": "C.E.F. FC Barcelona 리그 경기",
      "topics": [
        {
          "id": "m1-t1",
          "title": "넓은 공간으로 전개",
          "summary": "좁은 곳에 있는 선수에게 무리하게 넣기보다 넓게 열린 동료를 찾아 연결하고, 공을 옮기는 동안 다른 선수들이 전진할 시간을 확보합니다.",
          "unit_ids": [
            "u001"
          ]
        },
        {
          "id": "m1-t2",
          "title": "상대를 마주 보는 볼 컨트롤",
          "summary": "공을 받거나 운반할 때 LT를 누르면 이동 중에도 상대를 향한 자세를 유지해 다음 동작을 준비할 수 있습니다.",
          "unit_ids": [
            "u002"
          ]
        },
        {
          "id": "m1-t3",
          "title": "전진 전환과 역습",
          "summary": "전방 움직임을 확인해 빠르게 연결하고, 역습에서는 측면과 중앙의 역할을 나눠 두 개 이상의 패스 선택지를 만듭니다.",
          "unit_ids": [
            "u003",
            "u004",
            "u005"
          ]
        },
        {
          "id": "m1-t4",
          "title": "압박을 벗어나는 점유",
          "summary": "압박이 이미 붙은 상황에서 무리하게 전진하지 말고 안전한 패스로 압박을 피한 뒤, 동료의 움직임으로 수비를 끌어내 공간을 만듭니다.",
          "unit_ids": [
            "u006"
          ]
        },
        {
          "id": "m1-t5",
          "title": "침투 타이밍",
          "summary": "동료가 공간을 향해 연결할 것으로 예상되는 순간에는 멈추지 말고 움직임을 이어 갑니다.",
          "unit_ids": [
            "u007"
          ]
        },
        {
          "id": "m1-t6",
          "title": "공을 운반해 수비를 움직이기",
          "summary": "바로 패스해 좁은 곳에 동료를 가두기보다 공을 더 운반해 상대 한 명을 끌어내고, 동료의 전진 시간과 다음 선택지를 만듭니다. 자기 진영에서는 공을 잃었을 때의 역습 위험도 함께 고려합니다.",
          "unit_ids": [
            "u008"
          ]
        },
        {
          "id": "m1-t7",
          "title": "공격 폭 넓히기",
          "summary": "수평으로 폭을 넓혀 상대 수비를 벌리고, 열린 공간을 활용할 수 있게 합니다.",
          "unit_ids": [
            "u009"
          ]
        },
        {
          "id": "m1-t8",
          "title": "파이널서드의 폭과 침투 옵션",
          "summary": "전방이 막히면 넓은 쪽의 동료와 침투를 살피고, 풀백의 전진과 윙어의 중앙 이동을 조합해 크로스나 컷백 경로를 열어 둡니다.",
          "unit_ids": [
            "u010",
            "u011"
          ]
        },
        {
          "id": "m1-t9",
          "title": "대각 전개와 수비 균형 흔들기",
          "summary": "측면에서 대각선으로 전방 주자를 찾고, 공을 운반해 상대 수비의 균형을 먼저 흔들면 압박과 수비 대응을 끌어낼 수 있습니다.",
          "unit_ids": [
            "u012",
            "u013"
          ]
        },
        {
          "id": "m1-t10",
          "title": "밀집 수비를 풀어내기",
          "summary": "상대 수비가 촘촘하면 전방으로 억지로 찌르지 말고 뒤로 연결해 상대 블록을 다시 움직입니다.",
          "unit_ids": [
            "u014"
          ]
        },
        {
          "id": "m1-t11",
          "title": "받는 사람의 속도 살리기",
          "summary": "열린 전방 공간으로 패스할 때 땅볼을 우선해 받는 선수가 공의 진행 속도를 이어가며 다음 동작을 하기 쉽게 만듭니다.",
          "unit_ids": [
            "u015"
          ]
        },
        {
          "id": "m1-t12",
          "title": "막힐 때 지원 방향 바꾸기",
          "summary": "같은 방향의 돌파가 막히면 반복하지 말고 뒤쪽 지원을 확인해 안전하게 연결하거나 오버래핑 움직임을 활용해 공격 방식을 바꿉니다.",
          "unit_ids": [
            "u016"
          ]
        },
        {
          "id": "m1-t13",
          "title": "경기 핵심 정리",
          "summary": "대각선으로 움직이는 동료를 봐야 할 때 놓치지 않고, 수비가 밀집되면 미련 없이 뒤로 빼는 선택을 팀 전체의 기본 원칙으로 정리합니다.",
          "unit_ids": [
            "u017"
          ]
        }
      ]
