{
  "version": 1,
  "session_title": "C.E.F. 팀 연습 경기 피드백 (2024-01-04)",
  "matches": [
    {
      "id": "m1",
      "title": "BRO VAMOS vs CEF Barcelona",
      "topics": [
        {
          "id": "m1-t1",
          "title": "패스 방향과 수신 자세",
          "summary": "좁은 공간에 갇힌 선수만 찾지 말고 넓은 선택지를 보고, 압박을 받으면 패스를 준 선수를 향해 몸을 열어 다시 연결한다.",
          "unit_ids": [
            "u001",
            "u002"
          ]
        },
        {
          "id": "m1-t2",
          "title": "전진 패스와 움직임",
          "summary": "뒷공간으로 스루패스를 보낼 때는 수신자가 멈추지 않고 전진해 공격 속도를 이어간다.",
          "unit_ids": [
            "u003"
          ]
        },
        {
          "id": "m1-t3",
          "title": "역습에서 측면 역할과 선택지",
          "summary": "한 선수가 낮게 내려오면 다른 선수가 비어 있는 측면을 채우고, 공을 가진 선수는 수비를 끌어 동료가 고를 수 있는 패스 길을 연다.",
          "unit_ids": [
            "u004",
            "u005"
          ]
        },
        {
          "id": "m1-t4",
          "title": "압박에서 볼을 지키고 전진 연결",
          "summary": "공을 오래 끌거나 막힌 중앙으로 억지 패스를 넣기보다 안전하게 돌려받고, 상대를 움직인 뒤 전진할 공간을 만든다.",
          "unit_ids": [
            "u006",
            "u007",
            "u008"
          ]
        },
        {
          "id": "m1-t5",
          "title": "공격 폭 만들기",
          "summary": "가운데에만 모이지 말고 세로와 가로로 간격을 벌려 다음 패스가 들어갈 공간을 만든다.",
          "unit_ids": [
            "u009"
          ]
        },
        {
          "id": "m1-t6",
          "title": "측면 전개와 침투 타이밍",
          "summary": "앞이 막히면 바깥 공간을 사용하고, 풀백의 전진과 윙어의 안쪽 움직임을 맞춰 크로스나 컷백 선택지를 만든다.",
          "unit_ids": [
            "u010",
            "u011"
          ]
        },
        {
          "id": "m1-t7",
          "title": "대각 전개로 전진 시간 만들기",
          "summary": "좁은 쪽에 공을 고정하지 않고 대각선으로 빼 주면 중원이 고개를 들고 앞으로 뛰는 선수를 볼 여유가 생긴다.",
          "unit_ids": [
            "u012"
          ]
        },
        {
          "id": "m1-t8",
          "title": "수비 균형과 공격 재정비",
          "summary": "한 선수가 압박에 나설 때 함께 달려들어 균형을 무너뜨리지 않고, 상대 수비가 밀집하면 공을 뒤로 돌려 다시 전개한다.",
          "unit_ids": [
            "u013",
            "u014"
          ]
        },
        {
          "id": "m1-t9",
          "title": "마지막 패스와 지원",
          "summary": "받는 선수의 진행 방향을 살리는 패스를 선택하고, 돌파가 막히면 안전한 뒤쪽 연결이나 오버래핑으로 공격 방법을 바꾼다.",
          "unit_ids": [
            "u015",
            "u016"
          ]
        }
      ]
    }
  ],
