      "title": "공을 받을 때 LT로 상대를 바라보기",
      "position_tags": [
        "MF"
      ],
      "topic_tags": [
        "조작/키사용"
      ],
      "member_ids": [
        "taxi"
      ],
      "related_member_ids": [
        "gerrard",
