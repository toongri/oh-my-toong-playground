{
  "version": 1,
  "session_title": "FC Barcelona 팀 연습 피드백 — 공간 활용과 패스 선택",
  "matches": [
    {
      "id": "m1",
      "title": "BRO전 — 전개와 수비 판단",
      "topics": [
        {
          "id": "m1-t1",
          "title": "공간 선택과 공 없는 움직임",
          "summary": "좁은 곳 대신 넓은 곳으로 전개하면 공을 운반하기 쉽고, 공 없는 선수도 올라갈 시간을 얻는다.",
          "unit_ids": [
            "u001"
          ]
        },
        {
          "id": "m1-t2",
          "title": "수비 시 조작과 방향 유지",
          "summary": "상대가 공을 잡은 상황에서 LT 키로 몸의 방향을 유지하는 조작을 설명한다.",
          "unit_ids": [
            "u002"
          ]
        },
        {
          "id": "m1-t3",
          "title": "역습에서 패스 선택지 만들기",
          "summary": "조민을 부르며 역습 배치를 되짚는다. 루미가 측면 역할을 맡아 TIMEJ와 유미 쪽 선택지를 열어야 한다.",
          "unit_ids": [
            "u003"
          ]
        },
        {
          "id": "m1-t4",
          "title": "압박을 받는 전진 패스 대신 재순환",
          "summary": "공이 오기 전부터 압박을 받을 수 있는 장면에서 불필요한 동작을 지적한다. 후방 연결과 다시 받는 움직임을 권한다.",
          "unit_ids": [
            "u004"
          ]
        },
        {
          "id": "m1-t5",
          "title": "성급한 전달보다 운반",
          "summary": "좁은 곳의 TIMEJ에게 빠르게 주는 횟수가 많았다는 평가다. 공 소유자가 더 몰고 가 상대를 끌고, 팀이 올라올 시간을 벌 것을 제안한다.",
          "unit_ids": [
            "u005"
          ]
        },
        {
          "id": "m1-t6",
          "title": "폭을 벌려 전개",
          "summary": "선수들이 상하로 벌어지는 플레이가 필요하다고 짚는다.",
          "unit_ids": [
            "u006"
          ]
        },
        {
          "id": "m1-t7",
          "title": "제라드를 거쳐 넓은 공간 활용",
          "summary": "Gerrard_CEF에게 연결한 뒤 존재가 넓은 공간을 활용해 운반하거나 크로스·컷백을 하는 선택을 제안한다.",
          "unit_ids": [
            "u007"
          ]
        },
        {
          "id": "m1-t8",
          "title": "측면 전진과 중앙 침투",
          "summary": "사인드의 판단을 아쉬워하며 원전이 올라가는 동안 사인드가 중앙으로 들어가는 배치를 제시한다. 이 장면은 결국 득점으로 이어졌다.",
          "unit_ids": [
            "u008"
          ]
        },
        {
          "id": "m1-t9",
          "title": "측면에서 대각선으로 빼기",
          "summary": "측면 전개에서 넓은 공간을 보는 여유를 만들기 위해 대각선 패스를 강조한다.",
          "unit_ids": [
            "u009"
          ]
        },
        {
          "id": "m1-t10",
          "title": "수비 균형과 밀집 수비 대응",
          "summary": "원전이 균형을 무너뜨린 장면에서 공을 뺏으려는 태클 뒤 페널티가 나왔다고 짚는다. 태클한 선수는 분명하지 않다. 이후 상대 수비가 촘촘한 공격 장면에서는 뒤로 빼라고 한다.",
          "unit_ids": [
            "u010",
            "u011"
          ]
        },
        {
          "id": "m1-t11",
          "title": "패스 높이와 돌파 선택",
          "summary": "전방 연결이 열려 있으면 낮게 주어 받는 선수가 공의 속도를 살리게 한다. 맥구에게는 막힌 단독 돌파 대신 뒤쪽 지원과 다른 전개를 보라고 한다. 끝부분에서도 대각선과 후방 연결을 다시 강조한다.",
          "unit_ids": [
            "u012",
            "u013"
          ]
        }
      ]
    }
  ],
