  "session_title": "C.E.F. FC Barcelona 팀 연습 피드백 (24.1.4 Part 3)",
  "matches": [
    {
      "id": "m1",
      "title": "리그 경기 BRO vs FCB (1-2)",
      "topics": [
        {
          "id": "m1-t1",
          "title": "전반 빌드업: 받을 사람 고르기와 LT 활용",
          "summary": "전반 초반 두 장면에서 TIMEJ는 좁은 공간보다 넓은 공간에 있는 동료에게 주는 선택과, 주변에서 공을 잡을 때 LT 키를 누르고 움직이는 습관을 짚었다.",
          "unit_ids": [
            "u001",
            "u002"
          ]
        },
        {
          "id": "m1-t2",
          "title": "역습에서 윙어 역할로 패스 선택지 만들기",
          "summary": "역습 상황에서 루미가 윙어 역할을 해 줘야 공을 가진 동료에게 두 개의 패스 옵션이 생긴다는 설명이다. TIMEJ는 사인드와 맥구에게도 같은 이야기라고 덧붙였다.",
          "unit_ids": [
            "u003"
          ]
        },
        {
          "id": "m1-t3",
          "title": "압박 속 볼 처리와 오프더볼 움직임",
          "summary": "Gerrard_CEF가 공을 받는 순간부터 압박이 들어올 수 있던 장면과, 루미가 뛸 줄 알았던 순간에 멈춘 장면이다.",
          "unit_ids": [
            "u004",
            "u005"
          ]
        },
        {
          "id": "m1-t4",
          "title": "우리 진영에서 더 몰고 가기와 넓게 벌리기",
          "summary": "우리 진영에서 좁은 공간의 TIMEJ에게 바로 넘기기보다 직접 몰고 가 시간을 버는 선택, 그리고 위아래로 넓게 벌리는 플레이가 필요하다는 이야기다.",
          "unit_ids": [
            "u006",
            "u007"
          ]
        },
        {
          "id": "m1-t5",
          "title": "후반 공격 전개: 넓은 공간 활용",
          "summary": "막혔을 때 미련 없이 전환해 넓은 공간을 쓰는 방법, 동료가 측면을 차지할 때 중앙으로 들어가는 움직임, 측면에서 대각으로 빼 주는 패스를 다뤘다.",
          "unit_ids": [
            "u008",
            "u009",
            "u010"
          ]
        },
        {
          "id": "m1-t6",
          "title": "태클 판단과 밀집 수비 대처",
          "summary": "원전의 태클이 페널티로 이어진 장면과, 상대 수비가 촘촘할 때는 공격하지 말고 뒤로 빼야 한다는 설명이다.",
          "unit_ids": [
            "u011",
            "u012"
          ]
        },
        {
          "id": "m1-t7",
          "title": "패스 방식과 오늘의 총평",
          "summary": "열려 있으면 땅볼 패스가 낫다는 원칙, 맥구에게 돌파 대신 뒤로 살리거나 동료를 활용하라는 조언, 그리고 대각을 봐야 할 때 못 본 것과 밀집 수비에서 뒤로 빼는 것을 오늘의 핵심으로 정리했다.",
          "unit_ids": [
            "u013",
            "u014",
            "u015"
          ]
        }
      ]
    }
  ],
