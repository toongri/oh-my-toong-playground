  "matches": [
    {
      "id": "m1",
      "title": "BRO 대 FCB 연습 경기",
      "topics": [
        {
          "id": "m1-t1",
          "title": "공간을 보고 연결하기",
          "summary": "브라이드에게서 TIMEJ 쪽으로 오는 공이 많다는 관찰 뒤, 좁은 곳보다 넓은 곳의 동료에게 연결하고 막히면 뒤로 빼자는 지시가 이어진다.",
          "unit_ids": [
            "u001"
          ]
        },
        {
          "id": "m1-t2",
          "title": "공을 받을 때의 조작",
          "summary": "공 주변에서 상대를 바라보며 움직이기 위한 LT 조작을 설명한다. 이어진 스루패스와 W패스 언급은 화자가 자기 선택을 돌아본 말이다.",
          "unit_ids": [
            "u002"
          ]
        },
        {
          "id": "m1-t3",
          "title": "역습에서 패스 선택지 만들기",
          "summary": "조민을 호명하며 아쉬운 장면을 짚고, 사인드가 낮을 때 루미의 측면 역할과 기프에게 열어 줄 두 패스 선택지를 설명한다. 루미가 뛰어 나갈 것으로 기대했으나 멈췄다는 관찰도 이어진다.",
          "unit_ids": [
            "u003"
          ]
        },
        {
          "id": "m1-t4",
          "title": "압박 앞에서 전진 판단하기",
          "summary": "공을 받을 때 이미 압박이 들어올 수 있는 장면에서 뒤로 내주고 다시 받는 선택을 제시한다. 앞쪽 수비 숫자가 적은 상황에서는 무리한 전진보다 샘백을 거치는 선택을 설명한다.",
          "unit_ids": [
            "u004"
          ]
        },
        {
          "id": "m1-t5",
          "title": "좁은 곳으로 서둘러 주지 않기",
          "summary": "전진 패스가 잦았다는 평가와 함께 공을 더 몰고 상대를 끌어 동료가 올라올 시간을 벌자는 지시다. 우리 진영에서 공을 잃으면 곧바로 역습을 맞는다는 위험을 짚는다. 세로로 넓게 벌리는 플레이가 필요하다는 총평도 있다.",
          "unit_ids": [
            "u005"
          ]
        },
        {
          "id": "m1-t6",
          "title": "막힌 공격의 다른 경로",
          "summary": "경기 중 득점 장면에 대한 대화도 있었지만 별도 교정 행동은 없었다. 공격로가 막혔을 때 Gerrard_CEF에게 주면 존재가 넓은 공간을 활용할 수 있다는 선택을 설명한다.",
          "unit_ids": [
            "u006"
          ]
        },
        {
          "id": "m1-t7",
          "title": "측면과 중앙의 위치 교대",
          "summary": "사인드의 판단을 아쉬워하며 원전이 올라갈 때 사인드가 중앙으로 들어가고, 뒤에 있는 TIMEJ가 빈 중앙 공간을 메우는 배치를 설명한다. 이후 득점 결과가 나와 평가가 달라지는 반응도 남겼다.",
          "unit_ids": [
            "u007"
          ]
        },
        {
          "id": "m1-t8",
          "title": "넓은 공간을 향한 대각 연결",
          "summary": "스프레스의 장면을 보며 중원이 넓은 공간에서 전방으로 뛰는 선수를 볼 여유를 만들도록 대각 연결을 강조한다. 원전이 균형을 잃은 뒤 태클을 시도해 페널티가 난 장면은 결과 관찰로 남긴다.",
          "unit_ids": [
            "u008"
          ]
        },
        {
          "id": "m1-t9",
          "title": "촘촘한 수비 앞에서 재순환",
          "summary": "상대 수비가 촘촘하면 공격을 밀어붙이지 말고 뒤로 빼라는 지시다. 사인드와 루미를 언급하는 뒤 발화는 판단 근거가 불명확해 별도 유닛으로 세우지 않는다.",
          "unit_ids": [
            "u009"
          ]
        },
        {
          "id": "m1-t10",
          "title": "패스 높이와 막힌 돌파의 대안",
          "summary": "패스 길이 열려 있으면 땅볼을 우선하고 막힐 듯할 때 띄우는 선택을 설명한다. 맥구에게는 막힌 돌파를 반복하기보다 뒤로 안전하게 살리고 뒤의 동료를 보는 선택을 권한다. 마지막 총평에서도 수비 밀집 시 뒤로 빼는 판단을 재강조한다.",
          "unit_ids": [
            "u010",
            "u011"
          ]
        }
      ]
    }
  ],
