  "session_title": "C.E.F. FC Barcelona 경기 피드백 (2024.01.04)",
  "matches": [
    {
      "id": "m1",
      "title": "1경기 — BRO–FCB (1–4 요약 화면)",
      "topics": [
        {
          "id": "m1-t1",
          "title": "넓은 공간으로 전개",
          "summary": "브라이드에서 TIMEJ에게 오는 공이 많다는 장면을 짚으며, 좁은 공간의 선수보다 넓은 공간의 선수를 선택하면 공을 옮기기 쉽고 공 없는 선수도 올라갈 시간을 얻는다고 설명합니다.",
          "unit_ids": [
            "u001"
          ]
        },
        {
          "id": "m1-t2",
          "title": "LT 조작과 볼 보호",
          "summary": "LT를 누르고 움직이는 조작으로 동작한 선수를 바라보며 계속 움직이는 방법을 설명합니다.",
          "unit_ids": [
            "u002"
          ]
        },
        {
          "id": "m1-t3",
          "title": "역습에서 역할과 선택지 만들기",
          "summary": "사인드가 낮게 있는 장면에서는 루미가 윙어 역할을 맡아야 하고, 역습에서는 지원해 패스 선택지를 두 개 열어야 한다고 짚습니다.",
          "unit_ids": [
            "u003",
            "u004"
          ]
        },
        {
          "id": "m1-t4",
          "title": "압박 전에 다시 받기",
          "summary": "불필요한 동작을 줄이고, 압박이 들어오기 전에 뒤로 내준 뒤 LT를 눌러 다시 받을 수 있게 하라는 지시입니다.",
          "unit_ids": [
            "u005"
          ]
        },
        {
          "id": "m1-t5",
          "title": "전진 패스와 수비 유인",
          "summary": "수비 숫자가 적은 장면에서 제라드에게 무리하게 앞으로 넣어도 큰 이득이 없으므로, 샘백에게 보내 수비를 끌고 수비 숫자를 지우는 방법을 제안합니다.",
          "unit_ids": [
            "u006"
          ]
        },
        {
          "id": "m1-t6",
          "title": "루미의 움직임",
          "summary": "루미가 올라올 것으로 본 장면에서 멈춘 점을 짚습니다.",
          "unit_ids": [
            "u007"
          ]
        },
        {
          "id": "m1-t7",
          "title": "좁은 공간과 전진 선택",
          "summary": "오늘 유독 공을 던지는 빈도가 높았다고 평가하며, 좁은 공간에 바로 연결하기보다 직접 몰고 가 상대 한 명을 끌어 팀원이 올라올 시간을 벌라고 합니다. 우리 진영에서 빼앗기면 곧바로 역습을 맞을 수 있다는 위험도 짚습니다.",
          "unit_ids": [
            "u008"
          ]
        },
        {
          "id": "m1-t8",
          "title": "폭을 넓힌 전개",
          "summary": "상하로 넓게 벌리는 플레이가 필요하다고 평가합니다.",
          "unit_ids": [
            "u009"
          ]
        },
        {
          "id": "m1-t9",
          "title": "넓은 공간의 침투 연결",
          "summary": "막힌 상황에서 제라드에게 연결하면 존재가 넓은 공간을 활용해 몰고 들어가거나 크로스·컷백을 선택할 수 있다고 설명합니다.",
          "unit_ids": [
            "u010"
          ]
        },
        {
          "id": "m1-t10",
          "title": "역습 시 위치 교대",
          "summary": "원전이 전진할 때 사인드는 중앙으로 들어가고, TIMEJ는 뒤에서 중간 공간을 메우는 위치 관계를 설명합니다.",
          "unit_ids": [
            "u011"
          ]
        }
      ]
    },
    {
      "id": "m2",
      "title": "2경기 — BRO–FCB (0–2 플레이 화면)",
      "topics": [
        {
